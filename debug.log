    for lo in range(0, n, 2*w):\\n                L = nums[lo : lo+w]\\n                R = nums[lo+w : lo + 2*w]\\n                nums[lo : lo+2*w] = merge(L, R)\\n            w *= 2\\n\\n        return nums","compare_result":"111111111111111111111","title_slug":"sort-an-array","has_notes":false,"flag_type":1,"frontend_id":605},{"id":2174947670,"question_id":948,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0weeks, 2\xc2\xa0days","timestamp":1792283344,"status":50,"status_display":"Restrictions Failed","runtime":"N/A","url":"/submissions/detail/2174947670/","is_pending":"Not Pending","title":"Sort an Array","memory":"N/A","code":"class Solution:\\n    def sortArray(self, nums: List[int]) -> List[int]:\\n        n = len(nums)\\n\\n        for i in range(n - 1):\\n            min = i\\n            for j in range(i + 1, n):\\n                if nums[j] < nums[min]:\\n                    min = j\\n            nums[i], nums[min] = nums[min], nums[i]\\n\\n        return nums","compare_result":"111111111100000000000","title_slug":"sort-an-array","has_notes":false,"flag_type":1,"frontend_id":604},{"id":2174919704,"question_id":948,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0weeks, 2\xc2\xa0days","timestamp":1792276342,"status":50,"status_display":"Restrictions Failed","runtime":"N/A","url":"/submissions/detail/2174919704/","is_pending":"Not Pending","title":"Sort an Array","memory":"N/A","code":"class Solution:\\n    def sortArray(self, nums: List[int]) -> List[int]:\\n        n = len(nums)\\n        for i in range(n):\\n            swapped = False\\n            for j in range(n - i - 1):\\n                if nums[j] > nums[j + 1]:\\n                    nums[j], nums[j + 1] = nums[j + 1], nums[j]\\n                    swapped = True\\n            if swapped == False:\\n                return nums","compare_result":"111111111100000000000","title_slug":"sort-an-array","has_notes":false,"flag_type":1,"frontend_id":603},{"id":2174881548,"question_id":620,