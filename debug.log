lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790466724,"status":10,"status_display":"Accepted","runtime":"47 ms","url":"/submissions/detail/2154418161/","is_pending":"Not Pending","title":"Palindrome Partitioning","memory":"33.6 MB","code":"class Solution:\\n    def partition(self, s: str) -> list[list[str]]:\\n        ans = []\\n        subset = []\\n\\n        def backtrack(start):\\n            if start == len(s):\\n                ans.append(subset.copy())\\n                return\\n\\n            for i in range(start, len(s)):\\n                if s[start:i + 1] != s[start:i + 1][::-1]:\\n                    continue\\n                subset.append(s[start:i + 1])\\n                backtrack(i + 1)\\n                subset.pop()\\n\\n        backtrack(0)\\n        return ans","compare_result":"11111111111111111111111111111111","title_slug":"palindrome-partitioning","has_notes":false,"flag_type":1,"frontend_id":549},{"id":2154411674,"question_id":79,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790465110,"status":10,"status_display":"Accepted","runtime":"3800 ms","url":"/submissions/detail/2154411674/","is_pending":"Not Pending","title":"Word Search","memory":"19.4 MB","code":"class Solution:\\n    def exist(self, board: list[list[str]], word: str) -> bool:\\n        def backtrack(coloumn, row, index):\\n            if index == len(word):\\n                return True\\n\\n            if (row < 0 or row >= (len(board))) or (coloumn < 0 or coloumn >= len(board[0])):\\n                return False\\n\\n            if board[row][coloumn] != word[index]:\\n                return False\\n\\n            cur = board[row][coloumn]\\n            board[row][coloumn] = \'*\'\\n\\n            result = backtrack(coloumn + 1, row, index + 1) or backtrack(coloumn - 1, row, index + 1) or backtrack(coloumn, row + 1, index + 1) or \\\\\\n            backtrack(coloumn, row - 1, index + 1)\\n\\n\\n            board[row][coloumn] = cur\\n            return result\\n\\n        for r in range(len(board)):\\n            for c in range(len(board[0])):\\n                if backtrack(c, r, 0) == True:\\n                    return True\\n\\n        return False","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"word-search","has_notes":false,"flag_type":1,"frontend_id":548},{"id":2153381183,"question_id":17,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790372450,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2153381183/","is_pending":"Not Pending","title":"Letter Combinations of a Phone Number","memory":"19.5 MB","code":"class Solution:\\n    def letterCombinations(self, digits: str) -> List[str]:\\n        phoneMap = [\\n            \\"\\",     # 0\\n            \\"\\",     # 1\\n            \\"abc\\",  # 2\\n            \\"def\\",  # 3\\n            \\"ghi\\",  # 4\\n            \\"jkl\\",  # 5\\n            \\"mno\\",  # 6\\n            \\"pqrs\\", # 7\\n            \\"tuv\\",  # 8\\n            \\"wxyz\\"  # 9\\n        ]\\n\\n        ans = []\\n\\n        def backtrack(curList, index):\\n            if index == len(digits):\\n                ans.append(\\"\\".join(curList))\\n                return\\n\\n            for i in range(len(phoneMap[int(digits[index])])):\\n                curList.append(phoneMap[int(digits[index])][i])\\n                backtrack(curList, index + 1)\\n                curList.pop()\\n        \\n        backtrack([], 0)\\n        return ans","compare_result":"111111111111111111111111","title_slug":"letter-combinations-of-a-phone-number","has_notes":false,"flag_type":1,"frontend_id":547},{"id":2153380121,"question_id":17,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790372235,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2153380121/","is_pending":"Not Pending","title":"Letter Combinations of a Phone Number","memory":"19.5 MB","code":"class Solution:\\n    def letterCombinations(self, digits: str) -> List[str]:\\n        phoneMap = [\\n            \\"\\",     # 0\\n            \\"\\",     # 1\\n            \\"abc\\",  # 2\\n            \\"def\\",  # 3\\n            \\"ghi\\",  # 4\\n            \\"jkl\\",  # 5\\n            \\"mno\\",  # 6\\n            \\"pqrs\\", # 7\\n            \\"tuv\\",  # 8\\n            \\"wxyz\\"  # 9\\n        ]\\n\\n        ans = []\\n\\n        def backtrack(curStr, index):\\n            if index == len(digits):\\n                ans.append(curStr)\\n                return\\n\\n            for i in range(len(phoneMap[int(digits[index])])):\\n                backtrack(curStr + phoneMap[int(digits[index])][i], index + 1)\\n        \\n        backtrack(\'\', 0)\\n        return ans","compare_result":"111111111111111111111111","title_slug":"letter-combinations-of-a-phone-number","has_notes":false,"flag_type":1,"frontend_id":546},{"id":2152395264,"question_id":22,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790278681,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2152395264/","is_pending":"Not Pending","title":"Generate Parentheses","memory":"19.5 MB","code":"class Solution:\\n    def generateParenthesis(self, n: int) -> list[str]:\\n        ans = []\\n\\n        def backtrack(cur, counterOpen, counterClosed):\\n            if len(cur) == n * 2 and counterOpen == counterClosed:\\n                ans.append(cur)\\n                return\\n            \\n            if counterOpen < n:\\n                backtrack(cur + \'(\', counterOpen + 1, counterClosed)\\n\\n            if counterClosed < counterOpen:\\n                backtrack(cur + \')\', counterOpen, counterClosed + 1)\\n\\n        backtrack(\'\', 0, 0)\\n        return ans","compare_result":"11111111","title_slug":"generate-parentheses","has_notes":false,"flag_type":1,"frontend_id":545},{"id":2152394953,"question_id":22,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790278653,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/2152394953/","is_pending":"Not Pending","title":"Generate Parentheses","memory":"19.4 MB","code":"class Solution:\\n    def generateParenthesis(self, n: int) -> list[str]:\\n        ans = []\\n\\n        def backtrack(cur, counterOpen, counterClosed):\\n            if len(cur) == n * 2 and counterOpen == counterClosed:\\n                ans.append(cur)\\n                return\\n            \\n            if counterOpen <= n:\\n                backtrack(cur + \'(\', counterOpen + 1, counterClosed)\\n\\n            if counterClosed < counterOpen:\\n                backtrack(cur + \')\', counterOpen, counterClosed + 1)\\n\\n        backtrack(\'\', 0, 0)\\n        return ans","compare_result":"11111111","title_slug":"generate-parentheses","has_notes":false,"flag_type":1,"frontend_id":544},{"id":2151348214,"question_id":47,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790195015,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2151348214/","is_pending":"Not Pending","title":"Permutations II","memory":"19.8 MB","code":"class Solution:\\n    def permuteUnique(self, nums: list[int]) -> list[list[int]]:\\n        ans = []\\n        subset = []\\n        n = len(nums)\\n        used = [False] * n\\n        nums.sort()\\n\\n        def backtrack():\\n            if len(subset) == n:\\n                ans.append(subset.copy())\\n                return\\n\\n            for i in range(n):\\n                if used[i]:\\n                    continue\\n                \\n                if i > 0 and nums[i] == nums[i - 1] and not used[i - 1]:\\n                    continue\\n\\n                used[i] = True\\n                subset.append(nums[i])\\n                backtrack()\\n                used[i] = False\\n                subset.pop()\\n\\n        backtrack()\\n        return ans","compare_result":"111111111111111111111111111111111","title_slug":"permutations-ii","has_notes":false,"flag_type":1,"frontend_id":543},{"id":2151347298,"question_id":47,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790194907,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2151347298/","is_pending":"Not Pending","title":"Permutations II","memory":"19.8 MB","code":"class Solution:\\n    def permuteUnique(self, nums: list[int]) -> list[list[int]]:\\n        ans = []\\n        subset = []\\n        used = [False] * len(nums)\\n        nums.sort()\\n\\n        def backtrack():\\n            if len(subset) == len(nums):\\n                ans.append(subset.copy())\\n                return\\n\\n            for i in range(len(nums)):\\n                if used[i]:\\n                    continue\\n                \\n                if i > 0 and nums[i] == nums[i - 1] and not used[i - 1]:\\n                    continue\\n\\n                used[i] = True\\n                subset.append(nums[i])\\n                backtrack()\\n                used[i] = False\\n                subset.pop()\\n\\n        backtrack()\\n        return ans","compare_result":"111111111111111111111111111111111","title_slug":"permutations-ii","has_notes":false,"flag_type":1,"frontend_id":542},{"id":2151341617,"question_id":47,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790194283,"status":10,"status_display":"Accepted","runtime":"7 ms","url":"/submissions/detail/2151341617/","is_pending":"Not Pending","title":"Permutations II","memory":"20 MB","code":"class Solution:\\n    def permuteUnique(self, nums: list[int]) -> list[list[int]]:\\n        ans = []\\n        subset = []\\n        counts = Counter(nums)\\n\\n        def backtrack():\\n            if len(subset) == len(nums):\\n                ans.append(subset.copy())\\n                return\\n\\n            for num in counts:\\n                if counts[num] == 0:\\n                    continue\\n                counts[num] -= 1\\n                subset.append(num)\\n                backtrack()\\n                subset.pop()\\n                counts[num] += 1\\n\\n        backtrack()\\n        return ans","compare_result":"111111111111111111111111111111111","title_slug":"permutations-ii","has_notes":false,"flag_type":1,"frontend_id":541},{"id":2150186030,"question_id":90,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 2\xc2\xa0weeks","timestamp":1790106561,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2150186030/","is_pending":"Not Pending","title":"Subsets II","memory":"19.7 MB","code":"class Solution:\\n    def subsetsWithDup(self, nums: list[int]) -> list[list[int]]:\\n        ans = []\\n        subset = []\\n        nums.sort()\\n\\n        def backtrack(index):\\n            if index >= len(nums):\\n                ans.append(subset.copy())\\n                return\\n\\n            subset.append(nums[index])\\n            backtrack(index + 1)\\n\\n            subset.pop()\\n\\n            while index + 1 < len(nums) and nums[index + 1] == nums[index]:\\n                index += 1\\n\\n            backtrack(index + 1)\\n\\n        backtrack(0)\\n        return ans","compare_result":"111111111111111111111","title_slug":"subsets-ii","has_notes":false,"flag_type":1,"frontend_id":540}],"has_next":true,"last_key":""}'
