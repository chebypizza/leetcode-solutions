2\xa0months","timestamp":1785964017,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2095899550/","is_pending":"Not Pending","title":"Remove Nth Node From End of List","memory":"19.2 MB","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, val=0, next=None):\\n#         self.val = val\\n#         self.next = next\\nclass Solution:\\n    def removeNthFromEnd(self, head: Optional[ListNode], n: int) -> Optional[ListNode]:\\n        cur = head\\n        first = head\\n        k = 0\\n\\n        while cur:\\n            cur = cur.next\\n            k += 1\\n\\n        target = k - n\\n\\n        if target == 0:\\n            return head.next\\n\\n        cur = head\\n\\n        for i in range(target - 1):\\n            cur = cur.next\\n        \\n        cur.next = cur.next.next\\n\\n        return first","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"remove-nth-node-from-end-of-list","has_notes":false,"flag_type":1,"frontend_id":357},{"id":2094609064,"question_id":141,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0months","timestamp":1785879566,"status":10,"status_display":"Accepted","runtime":"53 ms","url":"/submissions/detail/2094609064/","is_pending":"Not Pending","title":"Linked List Cycle","memory":"23 MB","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, x):\\n#         self.val = x\\n#         self.next = None\\n\\nclass Solution:\\n    def hasCycle(self, head: Optional[ListNode]) -> bool:\\n        cur = head\\n        s = set()\\n        while cur:\\n            if cur in s:\\n                return True\\n            s.add(cur)\\n            cur = cur.next\\n        return False","compare_result":"11111111111111111111111111111","title_slug":"linked-list-cycle","has_notes":false,"flag_type":1,"frontend_id":356},{"id":2094606210,"question_id":141,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0months","timestamp":1785879105,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2094606210/","is_pending":"Not Pending","title":"Linked List Cycle","memory":"N/A","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, x):\\n#         self.val = x\\n#         self.next = None\\n\\nclass Solution:\\n    def hasCycle(self, head: Optional[ListNode]) -> bool:\\n        cur = head\\n        ar = []\\n        while cur:\\n            val = cur.val\\n            if val in ar:\\n                return True\\n            ar.append(val)\\n            cur = cur.next\\n        return False","compare_result":"11111111110111011101011101111","title_slug":"linked-list-cycle","has_notes":false,"flag_type":1,"frontend_id":355},{"id":2094419743,"question_id":4107,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0months","timestamp":1785865964,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/2094419743/","is_pending":"Not Pending","title":"Find Missing Elements","memory":"19.2 MB","code":"class Solution:\\n    def findMissingElements(self, nums: List[int]) -> List[int]:\\n        nums.sort()\\n        ar = []\\n        for i in range(len(nums) - 1):\\n            cur = nums[i]\\n            next = nums[i + 1]\\n            if cur + 1 != next:\\n                while cur + 1 != next:\\n                    ar.append(cur + 1)\\n                    cur = cur + 1\\n        return ar","compare_result":"","title_slug":"find-missing-elements","has_notes":false,"flag_type":1,"frontend_id":354},{"id":2093195039,"question_id":21,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0months","timestamp":1785789180,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2093195039/","is_pending":"Not Pending","title":"Merge Two Sorted Lists","memory":"19.4 MB","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, val=0, next=None):\\n#         self.val = val\\n#         self.next = next\\nclass Solution:\\n    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:\\n        start = ListNode(0)    #\xd0\xa1\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xb8\xd0\xb5 \xd1\x83\xd0\xb7\xd0\xbb\xd0\xb0 \xd1\x81 \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd1\x8b\xd0\xbc \xd0\xb8 \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0 \xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd1\x81\xd1\x82\xd0\xb2\xd0\xb5\xd0\xbd\xd0\xbd\xd1\x8b\xd0\xbc \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd0\xbe\xd0\xbc \xd0\xbd\xd0\xbe\xd0\xbb\xd1\x8c\\n        cur = start\\n\\n        while list1 and list2: #\xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0 \xd0\xbd\xd0\xb5 \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\xd1\x8b\xd0\xb5\\n            if list1.val > list2.val: #\xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f \xd0\xb2 \xd0\xbb\xd0\xb8\xd1\x81\xd1\x82\xd0\xb0\xd1\x85\\n                cur.next = list2     #\xd0\xbf\xd1\x80\xd0\xb8\xd1\x81\xd0\xbe\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd1\x8f\xd0\xb5\xd0\xbc \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbb\xd0\xb8\xd1\x81\xd1\x82\xd0\xb0 2 \xd0\xba cur\\n                list2 = list2.next    #\xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbc \xd0\xba \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x8e\xd1\x89\xd0\xb5\xd0\xbc\xd1\x83 \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd1\x83 \xd0\xb2 \xd0\xbb\xd0\xb8\xd1\x81\xd1\x82\xd0\xb5 2\\n            else:\\n                cur.next = list1     #\xd0\xbf\xd1\x80\xd0\xb8\xd1\x81\xd0\xbe\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd1\x8f\xd0\xb5\xd0\xbc \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbb\xd0\xb8\xd1\x81\xd1\x82\xd0\xb0 1 \xd0\xba cur\\n                list1 = list1.next    #\xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd1\x85\xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbc \xd0\xba \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x8e\xd1\x89\xd0\xb5\xd0\xbc\xd1\x83 \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd1\x83 \xd0\xb2 \xd0\xbb\xd0\xb8\xd1\x81\xd1\x82\xd0\xb5 1\\n            cur = cur.next      #\xd0\xbf\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xb2\xd0\xb8\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c \xd0\xbf\xd0\xbe\xd0\xb8\xd0\xbd\xd1\x82\xd0\xb5\xd1\x80 cur \xd0\xba \xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd1\x83\xd1\x89\xd0\xb5\xd0\xbc\xd1\x83, \xd1\x82\xd0\xbe\xd0\xbb\xd1\x8c\xd0\xba\xd0\xbe \xd1\x87\xd1\x82\xd0\xbe \xd1\x81\xd0\xbe\xd0\xb7\xd0\xb4\xd0\xb0\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xbc\xd1\x83 \xd1\x83\xd0\xb7\xd0\xbb\xd1\x83(line 13, 16)\\n        \\n        if list1:       #\xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xbf\xd1\x83\xd1\x81\xd1\x82\\n            cur.next = list1     #\xd0\xbf\xd1\x80\xd0\xb8\xd0\xba\xd1\x80\xd0\xb5\xd0\xbf\xd0\xbb\xd1\x8f\xd0\xb5\xd0\xbc \xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd0\xbe\xd0\xba  \xd0\xbb\xd0\xb8\xd1\x81\xd1\x82\xd0\xb01 \xd0\xba cur\\n        else:\\n            cur.next = list2   #\xd0\xbf\xd1\x80\xd0\xb8\xd0\xba\xd0\xbb\xd0\xb5\xd0\xbf\xd0\xbb\xd1\x8f\xd0\xb5\xd0\xbc \xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd0\xbe\xd0\xba \xd0\xbb\xd0\xb8\xd1\x81\xd1\x82\xd0\xb02 \xd0\xba cur\\n\\n        return start.next    #\xd1\x82 \xd0\xba cur  \xd1\x83\xd0\xbb\xd0\xb5\xd1\x82\xd0\xb5\xd0\xbb \xd0\xb2 \xd0\xba\xd0\xbe\xd0\xbd\xd0\xb5\xd1\x86, \xd1\x82\xd0\xbe \xd0\xb2\xd0\xbe\xd0\xb7\xd0\xb2\xd0\xb0\xd1\x80\xd1\x89\xd0\xb0\xd0\xb5\xd0\xbc start.next(\xd0\xbd\xd0\xb5 start, \xd0\xb0 \xd0\xb8\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe start.next \xd1\x82 \xd0\xba \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd1\x8b\xd0\xb9 \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82 \xd0\xbd\xd0\xb0\xd1\x88\xd0\xb5\xd0\xb3\xd0\xbe \xd0\xbd\xd0\xbe\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbb\xd0\xb8\xd1\x81\xd1\x82\xd0\xb0 \xd1\x8d\xd1\x82\xd0\xbe \xd0\xbd\xd0\xbe\xd0\xbb\xd1\x8c(line8))","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"merge-two-sorted-lists","has_notes":false,"flag_type":1,"frontend_id":353},{"id":2091871359,"question_id":206,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0months, 1\xc2\xa0week","timestamp":1785703251,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2091871359/","is_pending":"Not Pending","title":"Reverse Linked List","memory":"20.5 MB","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, val=0, next=None):\\n#         self.val = val\\n#         self.next = next\\nclass Solution:\\n    def reverseList(self, head: Optional[ListNode]) -> Optional[ListNode]:\\n        previousNode = None  #\xd0\x9f\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xb0\xd1\x8f prev \xd0\xb8\xd0\xb7\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe \xd1\x80\xd0\xb0\xd0\xb2\xd0\xbd\xd0\xb0 None, \xd0\xbf\xd0\xbe\xd1\x82\xd0\xbe\xd0\xbc\xd1\x83 \xd1\x87\xd1\x82\xd0\xbe \xd0\xbf\xd0\xb5\xd1\x80\xd0\xb2\xd1\x8b\xd0\xb9 \xd1\x83\xd0\xb7\xd0\xb5\xd0\xbb \xd0\xb8\xd1\x81\xd1\x85\xd0\xbe\xd0\xb4\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb0 \xd1\x81\xd1\x82\xd0\xb0\xd0\xbd\xd0\xb5\xd1\x82 \xd1\x81\xd0\xb0\xd0\xbc\xd1\x8b\xd0\xbc \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb8\xd0\xbc \xd1\x83\xd0\xb7\xd0\xbb\xd0\xbe\xd0\xbc \xd0\xb2 \xd1\x80\xd0\xb0\xd0\xb7\xd0\xb2\xd0\xb5\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd0\xbe\xd0\xbc \xd1\x81\xd0\xbf\xd0\xb8\xd1\x81\xd0\xba\xd0\xb5.\xd0\xa3 \xd0\xbb\xd1\x8e\xd0\xb1\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xb5\xd0\xb3\xd0\xbe \xd1\x83\xd0\xb7\xd0\xbb\xd0\xb0 \xd0\xb2 \xd0\xbe\xd0\xb4