"lang_name":"Python3","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1789241697,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2139960044/","is_pending":"Not Pending","title":"Running Sum of 1d Array","memory":"19.4 MB","code":"class Solution:\\n    def runningSum(self, nums: List[int]) -> List[int]:\\n        prefixSums = [nums[0]]\\n\\n        for i in range(1, len(nums)):\\n            prefixSums.append(prefixSums[i - 1] + nums[i])\\n\\n        return prefixSums","compare_result":"111111111111111111111111111111111111111111111111111111","title_slug":"running-sum-of-1d-array","has_notes":false,"flag_type":1,"frontend_id":512},{"id":2139953055,"question_id":92,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1789241065,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2139953055/","is_pending":"Not Pending","title":"Reverse Linked List II","memory":"19.3 MB","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, val=0, next=None):\\n#         self.val = val\\n#         self.next = next\\nclass Solution:\\n    def reverseBetween(self, head: Optional[ListNode], left: int, right: int) -> Optional[ListNode]:\\n        if not head:\\n            return \\n\\n        cur = head\\n        prev = None\\n        curIndex = 1\\n\\n        while cur:\\n            if curIndex == left:\\n                beforeStart = prev\\n                tail = cur\\n\\n                for _ in range(right - left + 1):\\n                    nextN = cur.next\\n                    cur.next = prev\\n                    prev = cur\\n                    cur = nextN\\n                \\n                tail.next = cur\\n\\n                if beforeStart:\\n                    beforeStart.next = prev\\n                else:\\n                    return prev\\n                break\\n\\n            prev = cur\\n            cur = cur.next\\n            curIndex += 1\\n\\n        return head","compare_result":"11111111111111111111111111111111111111111111","title_slug":"reverse-linked-list-ii","has_notes":false,"flag_type":1,"frontend_id":511},{"id":2139943697,"question_id":92,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1789240266,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2139943697/","is_pending":"Not Pending","title":"Reverse Linked List II","memory":"19.4 MB","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, val=0, next=None):\\n#         self.val = val\\n#         self.next = next\\nclass Solution:\\n    def reverseBetween(self, head: Optional[ListNode], left: int, right: int) -> Optional[ListNode]:\\n        if not head:\\n            return \\n\\n        cur = head\\n        curIndex = 1\\n        prev = None\\n\\n        while cur:\\n            if curIndex == left:\\n                beforeStart = prev\\n                tail = cur\\n\\n                for _ in range(right-left + 1):\\n                    nextN = cur.next\\n                    cur.next = prev\\n                    prev = cur\\n                    cur = nextN\\n                \\n                tail.next = cur   \\n                if beforeStart:\\n                    beforeStart.next = prev\\n                else:\\n                    head = prev\\n                break\\n\\n            prev = cur\\n            cur = cur.next\\n            curIndex += 1\\n\\n        return head","compare_result":"11111111111111111111111111111111111111111111","title_slug":"reverse-linked-list-ii","has_notes":false,"flag_type":1,"frontend_id":510},{"id":2138938195,"question_id":76,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1789156592,"status":10,"status_display":"Accepted","runtime":"66 ms","url":"/submissions/detail/2138938195/","is_pending":"Not Pending","title":"Minimum Window Substring","memory":"19.8 MB","code":"class Solution:\\n    def minWindow(self, s: str, t: str) -> str:\\n        #\xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb4\xd0\xbe\xd1\x85\xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbc \xd0\xb4\xd0\xbe \xd0\xba\xd0\xbe\xd0\xbd\xd1\x86\xd0\xb0 t, \xd1\x82\xd0\xbe \xd1\x81\xd0\xb4\xd0\xb2\xd0\xb8\xd0\xb3\xd0\xb0\xd0\xb5\xd0\xbc left, \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0 dict(s) != dict(t), \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x88\xd0\xbb\xd0\xb8 2 \xd1\x80\xd0\xb0\xd0\xbd\xd0\xb2\xd1\x8b\xd1\x85 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8f, \xd1\x82\xd0\xbe \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xbb\xd0\xb6\xd0\xb0\xd0\xb5\xd0\xbc \xd0\xb4\xd0\xb2\xd0\xb8\xd0\xb3\xd0\xb0\xd1\x82\xd1\x8c right, \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0 left \xd1\x81\xd1\x82\xd0\xbe\xd0\xb8\xd1\x82 \xd0\xbd\xd0\xb0 \xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb5\\n        left = 0\\n        counts1 = defaultdict(int)\\n        counts2 = Counter(t)\\n        minWindow = 100000\\n        needed = len(counts2)\\n        now = 0\\n\\n        for right in range(len(s)):\\n            counts1[s[right]] += 1\\n            if s[right] in counts2 and counts2[s[right]] == counts1[s[right]]:\\n                now += 1\\n                while left <= right and now == needed:\\n                    if minWindow > right - left + 1:\\n                        minWindow = right - left + 1\\n                        startIndex = left\\n                        endIndex = right\\n\\n                    if counts2[s[left]] == counts1[s[left]]:\\n                        now -= 1\\n\\n                    counts1[s[left]] -= 1\\n                    left += 1\\n            right += 1\\n        \\n        if minWindow != 100000:\\n            return s[startIndex:endIndex + 1]\\n\\n        return \'\'","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111