ight];\\n\\n                if (curSum == 0)\\n                {\\n                    ans.push_back({nums[i], nums[left], nums[right]});\\n                    left += 1;\\n                    right -=1;\\n\\n                    while(left < right && nums[left] == nums[left - 1])\\n                    {\\n                        left += 1;\\n                    }\\n                    while(left < right && nums[right] == nums[right + 1])\\n                    {\\n                        right -= 1;\\n                    }\\n                }\\n\\n                else if(curSum > 0)\\n                {\\n                    right -= 1;\\n                }\\n                else\\n                {\\n                    left += 1;\\n                }\\n            }\\n        }\\n\\n        return ans;\\n    }\\n};","compare_result":"","title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":516},{"id":2143065893,"question_id":15,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 3\xc2\xa0weeks","timestamp":1789505848,"status":10,"status_display":"Accepted","runtime":"499 ms","url":"/submissions/detail/2143065893/","is_pending":"Not Pending","title":"3Sum","memory":"22.3 MB","code":"class Solution:\\n    def threeSum(self, nums: list[int]) -> list[list[int]]:\\n        nums.sort()\\n        ans = []\\n        left = 0\\n        right = len(nums) - 1\\n\\n        for i in range(len(nums) - 2):\\n            if nums[i] > 0:\\n                break\\n                \\n            if i != 0 and nums[i] == nums[i - 1]:\\n                continue\\n\\n            left = i + 1\\n            right = len(nums) - 1\\n\\n            while left < right:\\n                curSum = nums[left] + nums[right] + nums[i]\\n                \\n                if curSum == 0:\\n                    ans.append([nums[i], nums[left], nums[right]])\\n                    left += 1\\n                    right -= 1\\n\\n                    while left < right and nums[left] ==