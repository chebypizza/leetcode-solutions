ight];\\n\\n                if (curSum == 0)\\n                {\\n                    ans.push_back({nums[i], nums[left], nums[right]});\\n                    left += 1;\\n                    right -=1;\\n\\n                    while(left < right && nums[left] == nums[left - 1])\\n                    {\\n                        left += 1;\\n                    }\\n                    while(left < right && nums[right] == nums[right + 1])\\n                    {\\n                        right -= 1;\\n                    }\\n                }\\n\\n                else if(curSum > 0)\\n                {\\n                    right -= 1;\\n                }\\n                else\\n                {\\n                    left += 1;\\n                }\\n            }\\n        }\\n\\n        return ans;\\n    }\\n};","compare_result":"","title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":516},{"id":2143065893,"question_id":15,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 3\xc2\xa0weeks","timestamp":1789505848,"status":10,"status_display":"Accepted","runtime":"499 ms","url":"/submissions/detail/2143065893/","is_pending":"Not Pending","title":"3Sum","memory":"22.3 MB","code":"class Solution:\\n    def threeSum(self, nums: list[int]) -> list[list[int]]:\\n        nums.sort()\\n        ans = []\\n        left = 0\\n        right = len(nums) - 1\\n\\n        for i in range(len(nums) - 2):\\n            if nums[i] > 0:\\n                break\\n                \\n            if i != 0 and nums[i] == nums[i - 1]:\\n                continue\\n\\n            left = i + 1\\n            right = len(nums) - 1\\n\\n            while left < right:\\n                curSum = nums[left] + nums[right] + nums[i]\\n                \\n                if curSum == 0:\\n                    ans.append([nums[i], nums[left], nums[right]])\\n                    left += 1\\n                    right -= 1\\n\\n                    while left < right and nums[left] == nums[left - 1]:\\n                        left += 1\\n                    while left < right and nums[right] == nums[right + 1]:\\n                        right -= 1\\n\\n                elif curSum > 0:\\n                    right -= 1\\n                else:\\n                    left += 1\\n        \\n        return ans ","compare_result":"","title_slug":"3sum","has_notes":false,"flag_type":1,"frontend_id":515},{"id":2141652130,"question_id":2556,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 3\xc2\xa0weeks","timestamp":1789396165,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2141652130/","is_pending":"Not Pending","title":"Convert the Temperature","memory":"19.2 MB","code":"class Solution:\\n    def convertTemperature(self, celsius: float) -> List[float]:\\n        ans = []\\n        ans.append(celsius + 273.15)\\n        ans.append(celsius * 1.8 + 32)\\n\\n        return ans","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"convert-the-temperature","has_notes":false,"flag_type":1,"frontend_id":514},{"id":2140720866,"question_id":724,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1789311767,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2140720866/","is_pending":"Not Pending","title":"Find Pivot Index","memory":"35.6 MB","code":"class Solution {\\npublic:\\n    int pivotIndex(vector<int>& nums) {\\n        int generalSum = std::accumulate(nums.begin(), nums.end(), 0);\\n        int curSum = 0;\\n\\n        for(int i = 0; i < nums.size(); ++i){\\n            if (curSum * 2 + nums[i] == generalSum){\\n                return i;\\n            }\\n\\n            curSum += nums[i];\\n        }\\n\\n        return -1;\\n    }\\n};","compare_result":"","title_slug":"find-pivot-index","has_notes":false,"flag_type":1,"frontend_id":513},{"id":2139960044,"question_id":1603,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1789241697,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2139960044/","is_pending":"Not Pending","title":"Running Sum of 1d Array","memory":"19.4 MB","code":"class Solution:\\n    def runningSum(self, nums: List[int]) -> List[int]:\\n        prefixSums = [nums[0]]\\n\\n        for i in range(1, len(nums)):\\n            prefixSums.append(prefixSums[i - 1] + nums[i])\\n\\n        return prefixSums","compare_result":"111111111111111111111111111111111111111111111111111111","title_slug":"running-sum-of-1d-array","has_notes":false,"flag_type":1,"frontend_id":512},{"id":2139953055,"question_id":92,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1789241065,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2139953055/","is_pending":"Not Pending","title":"Reverse Linked List II","memory":"19.3 MB","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, val=0, next=None):\\n#         self.val = val\\n#         self.next = next\\nclass Solution:\\n    def reverseBetween(self, head: Optional[ListNode], left: int, right: int) -> Optional[ListNode]:\\n        if not head:\\n            return \\n\\n        cur = head\\n        prev = None\\n        curIndex = 1\\n\\n        while cur:\\n            if curIndex == left:\\n                beforeStart = prev\\n                tail = cur\\n\\n                for _ in range(right - left + 1):\\n                    nextN = cur.next\\n                    cur.next = prev\\n                    prev = cur\\n                    cur = nextN\\n                \\n                tail.next = cur\\n\\n                if beforeStart:\\n                    beforeStart.next = prev\\n                else:\\n                    return prev\\n                break\\n\\n            prev = cur\\n            cur = cur.next\\n        