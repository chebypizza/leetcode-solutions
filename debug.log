title":"Reorder List","memory":"27.9 MB","code":"# Definition for singly-linked list.\\n# class ListNode:\\n#     def __init__(self, val=0, next=None):\\n#         self.val = val\\n#         self.next = next\\nclass Solution:\\n    def reorderList(self, head: Optional[ListNode]) -> None:\\n        if not head or not head.next:\\n            return \\n        #\xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0 \xd0\xbd\xd0\xb5 \xd0\xb7\xd0\xb0\xd0\xba\xd0\xbe\xd0\xbd\xd1\x87\xd0\xb8\xd1\x82\xd1\x81\xd1\x8f \xd0\xbe\xd0\xb4\xd0\xbd\xd0\xb0 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xbd\xd0\xb0 \xd0\xb2\xd1\x81\xd1\x82\xd0\xb0\xd0\xb2\xd0\xbb\xd1\x8f\xd1\x82\xd1\x8c \xd1\x8d\xd0\xbb\xd0\xb5\xd0\xbc\xd0\xb5\xd0\xbd\xd1\x82\xd1\x8b \xd0\xbf\xd0\xbe\xd0\xbe\xd1\x87\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb4\xd0\xbd\xd0\xbe\\n        slow = head\\n        fast = head\\n\\n        while fast and fast.next:\\n            slow = slow.next\\n            fast = fast.next.next\\n\\n        #\xd0\xbd\xd0\xb0\xd0\xb4\xd0\xbe \xd1\x80\xd0\xb0\xd0\xb7\xd0\xb2\xd0\xb5\xd1\x80\xd0\xbd\xd1\x83\xd1\x82\xd1\x8c slow.next\\n        prev = None\\n        cur = slow.next\\n        slow.next = None  #\xd0\xbe\xd1\x82\xd1\x80\xd0\xb5\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2\xd1\x82\xd0\xbe\xd1\x80\xd1\x83\xd1\x8e \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xbd\xd1\x83\\n\\n        while cur:\\n            nextNode = cur.next\\n            cur.next = prev\\n            prev = cur         #\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd0\xbe \xd0\xb2\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xb9 \xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb8\xd0\xbd\xd1\x8b \xd0\xbf\xd0\xbe\xd1\x81\xd0\xbb\xd0\xb5 \xd1\x86\xd0\xb8\xd0\xba\xd0\xbb\xd0\xb0(prev)\\n            cur = nextNode\\n\\n        first = head\\n        second = prev #\xd1\x83\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd1\x82\xd1\x8c \xd0\xb2 while, \xd1\x82 \xd0\xba \xd0\xb1\xd1\x83\xd0\xb4\xd0\xb5\xd1\x82 \xd0\xbd\xd0\xb0 1 \xd0\xbc\xd0\xb5\xd0\xbd\xd1\x8c\xd1\x88\xd0\xb5 \xd0\xbc\xd0\xb1\\n        \\n        while second:\\n            nextNode1 = first.next   #first tail\\n            nextNode2 = second.next    #second tail \\n            first.next = second       #1st node -> second \\n            second.next = nextNode1     #2nd node -> first tail\\n            first = nextNode1\\n            second = nextNode2","compare_result":"111111111111","title_slug":"reorder-list","has_notes":false,"flag_type":1,"frontend_id":360}],"has_next":true,"last_key":""}'
