 high = nums.size() - 1;\\n\\n        while (mid <= high)\\n        {\\n            if (nums[mid] == 0)\\n            {\\n                swap(nums[low], nums[mid]);\\n                mid++;\\n                low++;\\n            }\\n            else if (nums[mid] == 1)\\n            {\\n                mid++;\\n            }\\n            else\\n            {\\n                swap(nums[mid], nums[high]);\\n                high--;\\n            }\\n        }\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"sort-colors","has_notes":false,"flag_type":1,"frontend_id":522},{"id":2144098756,"question_id":75,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 3\xc2\xa0weeks","timestamp":1789590280,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2144098756/","is_pending":"Not Pending","title":"Sort Colors","memory":"19.4 MB","code":"class Solution:\\n    def sortColors(self, nums: list[int]) -> None:\\n        low = 0\\n        mid = 0\\n        high = len(nums) - 1\\n\\n        while mid <= high:\\n            if nums[mid] == 0:\\n                nums[low], nums[mid] = nums[mid], nums[low]\\n                low += 1\\n                mid += 1\\n            elif nums[mid] == 1:\\n                mid += 1\\n            else:\\n                nums[mid], nums[high] = nums[high], nums[mid]\\n                high -= 1","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"sort-colors","has_notes":false,"flag_type":1,"frontend_id":521},{"id":2144093938,"question_id":75,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 3\xc2\xa0weeks","timestamp":1789589706,"status":10,"status_display":"Accepted","runtime":"3 ms","url":"/submissions/detail/2144093938/","is_pending":"Not Pending","title":"Sort Colors","memory":"19.4 MB","code":"class Solution:\\n    def sortColors(self, nums: list[int]) -> None:\\n        i = 0\\n\\n        while i < len(nums) - 1:\\n            if nums[i] > nums[i + 1]:\\n                nums[i], nums[i + 1] = nums[i + 1], nums[i]\\n                if i != 0:\\n                    i -= 1\\n                else:\\n                    i = 0\\n            else:\\n                i += 1\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"sort-colors","has_notes":false,"flag_type":1,"frontend_id":520}],"has_next":true,"last_key":""}'
