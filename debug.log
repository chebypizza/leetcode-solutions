":"19.4 MB","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def invertTree(self, root: Optional[TreeNode]) -> Optional[TreeNode]:\\n        if root is None:\\n            return None\\n\\n        root.left, root.right = self.invertTree(root.right), self.invertTree(root.left)\\n        return root","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"invert-binary-tree","has_notes":false,"flag_type":1,"frontend_id":384},{"id":2103418967,"question_id":226,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1786480071,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2103418967/","is_pending":"Not Pending","title":"Invert Binary Tree","memory":"19.3 MB","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def invertTree(self, root: Optional[TreeNode]) -> Optional[TreeNode]:\\n        if root is None:\\n            return None\\n\\n        newRoot = TreeNode(root.val)\\n        root.left, root.right = self.invertTree(root.right), self.invertTree(root.left)\\n        return root","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"invert-binary-tree","has_notes":false,"flag_type":1,"frontend_id":383},{"id":2102079993,"question_id":424,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 4\xc2\xa0weeks","timestamp":1786398548,"status":10,"status_display":"Accepted","runtime":"59 ms","url":"/submissions/detail/2102079993/","is_pending":"Not Pending","title":"Longest Repeating Character Replacement","memory":"19.7 M