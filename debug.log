Substring","memory":"19.8 MB","code":"class Solution:\\n    def minWindow(self, s: str, t: str) -> str:\\n        #\xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xb4\xd0\xbe\xd1\x85\xd0\xbe\xd0\xb4\xd0\xb8\xd0\xbc \xd0\xb4\xd0\xbe \xd0\xba\xd0\xbe\xd0\xbd\xd1\x86\xd0\xb0 t, \xd1\x82\xd0\xbe \xd1\x81\xd0\xb4\xd0\xb2\xd0\xb8\xd0\xb3\xd0\xb0\xd0\xb5\xd0\xbc left, \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0 dict(s) != dict(t), \xd0\xb5\xd1\x81\xd0\xbb\xd0\xb8 \xd0\xbd\xd0\xb5 \xd0\xbd\xd0\xb0\xd1\x88\xd0\xbb\xd0\xb8 2 \xd1\x80\xd0\xb0\xd0\xbd\xd0\xb2\xd1\x8b\xd1\x85 \xd1\x81\xd0\xbb\xd0\xbe\xd0\xb2\xd0\xb0\xd1\x80\xd1\x8f, \xd1\x82\xd0\xbe \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb4\xd0\xbe\xd0\xbb\xd0\xb6\xd0\xb0\xd0\xb5\xd0\xbc \xd0\xb4\xd0\xb2\xd0\xb8\xd0\xb3\xd0\xb0\xd1\x82\xd1\x8c right, \xd0\xbf\xd0\xbe\xd0\xba\xd0\xb0 left \xd1\x81\xd1\x82\xd0\xbe\xd0\xb8\xd1\x82 \xd0\xbd\xd0\xb0 \xd0\xbc\xd0\xb5\xd1\x81\xd1\x82\xd0\xb5\\n        left = 0\\n        counts1 = defaultdict(int)\\n        counts2 = Counter(t)\\n        minWindow = 100000\\n        needed = len(counts2)\\n        now = 0\\n\\n        for right in range(len(s)):\\n            counts1[s[right]] += 1\\n            if s[right] in counts2 and counts2[s[right]] == counts1[s[right]]:\\n                now += 1\\n                while left <= right and now == needed:\\n                    if minWindow > right - left + 1:\\n                        minWindow = right - left + 1\\n                        startIndex = left\\n                        endIndex = right\\n\\n                    if counts2[s[left]] == counts1[s[left]]:\\n                        now -= 1\\n\\n                    counts1[s[left]] -= 1\\n                    left += 1\\n            right += 1\\n        \\n        if minWindow != 100000:\\n            return s[startIndex:endIndex + 1]\\n\\n        return \'\'","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111