atus":10,"status_display":"Accepted","runtime":"7 ms","url":"/submissions/detail/2122330578/","is_pending":"Not Pending","title":"Sqrt(x)","memory":"19.2 MB","code":"class Solution:\\n    def mySqrt(self, x: int) -> int:\\n        left = 0\\n        right = x\\n\\n        while left <= right:\\n            mid = (left + right) // 2\\n            if mid * mid == x:\\n                return mid\\n            elif mid * mid > x:\\n                right = mid - 1\\n            else:\\n                left = mid + 1\\n\\n        return right","compare_result":"","title_slug":"sqrtx","has_notes":false,"flag_type":1,"frontend_id":447},{"id":2121086302,"question_id":367,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1787764584,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2121086302/","is_pending":"Not Pending","title":"Valid Perfect Square","memory":"19.2 MB","code":"class Solution:\\n    def isPerfectSquare(self, num: int) -> bool:\\n        if num < 2:\\n            return True\\n\\n        left = 2\\n        right = num\\n\\n        while left <= right:\\n            mid = (left + right) // 2\\n            if mid * mid == num:\\n                return True\\n            elif mid * mid > num:\\n                right = mid - 1\\n            else:\\n                left = mid + 1\\n\\n        return False\\n","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"valid-perfect-square","has_notes":false,"flag_type":1,"frontend_id":446},{"id":2120155819,"question_id":84,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1787690311,"status":10,"status_display":"Accepted","runtime":"107 ms","url":"/submissions/detail/2120155819/","is_pending":"Not Pending","title":"Largest Rectangle in Histogram","memory":"31.2 MB","code":"class Solution:\\n    def largestRectangleArea(self, heights: List[int]) -> int:\\n        stack = []\\n        maxAns = 0\\n\\n        for i in range(len(heights)):\\n            while stack and heights[stack[-1]] > heights[i]:\\n                last = stack.pop()\\n                height = heights[last]\\n                if stack:\\n                    width = i - stack[-1] - 1\\n                else:\\n                    width = i\\n                maxAns = max(maxAns, height * width)\\n            stack.append(i)\\n\\n        #\xd0\xbe\xd1\x81\xd1\x82\xd0\xb0\xd1\x82\xd0\xba\xd0\xb8 \xd0\xb2 \xd1\x81\xd1\x82\xd0\xb5\xd0\xba\xd0\xb5\\n        i = len(heights)\\n        while stack:\\n            last = stack.pop()\\n            height = heights[last]\\n            if stack:\\n                width = i - stack[-1] - 1\\n            else:\\n                width = i\\n            maxAns = max(maxAns, height * width)\\n\\n        return maxAns","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"largest-rectangle-in-histogram","has_notes":false,"flag_type":1,"frontend_id":445},{"id":2120154091,"question_id":84,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1787690127,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2120154091/","is_pending":"Not Pending","title":"Largest Rectangle in Histogram","memory":"N/A","code":"class Solution:\\n    def largestRectangleArea(self, heights: List[int]) -> int:\\n        stack = []\\n        maxAns = 0\\n\\n        for i in range(len(heights)):\\n            while stack and heights[stack[-1]] > heights[i]:\\n                last = stack.pop()\\n                height = heights[last]\\n                if stack:\\n                    width = i - stack[-1] - 1\\n                else:\\n                    width = i\\n                maxAns = max(maxAns, height * width)\\n            stack.append(i)\\n            \\n        #\xd0\xbe\xd1\x81\xd1\x82\xd0\