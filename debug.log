n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"largest-rectangle-in-histogram","has_notes":false,"flag_type":1,"frontend_id":465},{"id":2128901338,"question_id":84,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1788376880,"status":10,"status_display":"Accepted","runtime":"6 ms","url":"/submissions/detail/2128901338/","is_pending":"Not Pending","title":"Largest Rectangle in Histogram","memory":"80.6 MB","code":"class Solution {\\npublic:\\n    int largestRectangleArea(vector<int>& heights) {\\n        std::ios_base::sync_with_stdio(false);\\n        std::cin.tie(NULL);\\n\\n        heights.push_back(0);\\n\\n        int n = heights.size();\\n        int maxAns = 0;\\n\\n        vector<int> stack;\\n        stack.reserve(n);\\n\\n        for (int i = 0; i < n; i++){\\n            while (!stack.empty() && heights[stack.back()] > heights[i]){\\n                int last = stack.back();\\n                stack.pop_back();\\n                int height = heights[last];\\n                int width;\\n\\n                if (!stack.empty()) {\\n                    width = i - stack.back() - 1;\\n                }\\n                else{\\n                    width = i;\\n                }\\n\\n                maxAns = std::max(maxAns, width * height);\\n            }\\n            stack.push_back(i);\\n        }\\n\\n        return maxAns;\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"largest-rectangle-in-histogram","has_notes":false,"flag_type":1,"frontend_id":464},{"id":2127723386,"question_id":560,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1788293504,"status":10,"status_display":"Accepted","runtime":"34 ms","url":"/submissions/detail/2127723386/","is_pending":"Not Pending","title":"Subarray Sum Equals K","memory":"45.4 MB","code":"class Solution {\\npublic:\\n    int subarraySum(vector<int>& nums, int k) {\\n        std::unordered_map<int, int>dictSeen;\\n        int count = 0;\\n        int curSum = 0;\\n        int n = nums.size();\\n        dictSeen[0] = 1;\\n\\n        for (int i = 0; i < n; i++) {                      //curSum - k = targetCurSum\\n            curSum += nums[i];\\n            if (dictSeen.find(curSum - k) != dictSeen.end()){\\n                count += dictSeen[curSum - k];\\n            }\\n            dictSeen[curSum]++;\\n        }\\n\\n        return count;\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"subarray-sum-equals-k","has_notes":false,"flag_type":1,"frontend_id":463},{"id":2127722518,"question_id":560,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp":1788293421,"status":10,"status_display":"Accepted","runtime":"66 ms","url":"/submissions/detail/2127722518/","is_pending":"Not Pending","title":"Subarray Sum Equals K","memory":"47.8 MB","code":"class Solution {\\npublic:\\n    int subarraySum(vector<int>& nums, int k) {\\n        std::map<int, int>dictSeen;\\n        int count = 0;\\n        int curSum = 0;\\n        int n = nums.size();\\n        dictSeen[0] = 1;\\n\\n        for (int i = 0; i < n; i++) {                      //curSum - k = targetCurSum\\n            curSum += nums[i];\\n            if (dictSeen.find(curSum - k) != dictSeen.end()){\\n                count += dictSeen[curSum - k];\\n            }\\n            dictSeen[curSum]++;\\n        }\\n\\n        return count;\\n    }\\n};","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"subarray-sum-equals-k","has_notes":false,"flag_type":1,"frontend_id":462},{"id":2127713440,"question_id":560,"lang":"cpp","lang_name":"C++","time":"2\xc2\xa0months, 1\xc2\xa0week","timestamp