bmissions/detail/2118961767/","is_pending":"Not Pending","title":"Trapping Rain Water","memory":"21.4 MB","code":"class Solution:\\n    def trap(self, height: List[int]) -> int:\\n        stack = []\\n        finalAnswer = 0                                                 #5, 3, 2,  4 - > 5(stack[-1]), 3(depth),  4(height[i])\\n\\n        for i in range(len(height)):\\n            while stack and height[stack[-1]] < height[i]:\\n                depth = stack.pop()\\n                if not stack:\\n                    break\\n                width = i - stack[-1] - 1\\n                waterHeight = min(height[stack[-1]], height[i]) - height[depth]\\n                finalAnswer += width * waterHeight\\n            stack.append(i)\\n\\n        return finalAnswer","compare_result":"","title_slug":"trapping-rain-water","has_notes":false,"flag_type":1,"frontend_id":442},{"id":2118904511,"question_id":496,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1787599712,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2118904511/","is_pending":"Not Pending","title":"Next Greater Element I","memory":"19.4 MB","code":"class Solution:\\n    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:\\n        ans = [-1] * len(nums1)\\n        stack = []\\n        dict = {}\\n\\n        for i in range(len(nums2)):\\n            while stack and nums2[stack[-1]] < nums2[i]:\\n                last = stack.pop()       #\xd0\xb8\xd0\xbd\xd0\xb4\xd0\xb5\xd0\xba\xd1\x81 \xd1\x87\xd0\xb8\xd1\x81\xd0\xbb\xd0\xb0, \xd0\xba\xd0\xbe\xd1\x82\xd0\xbe\xd1\x80\xd0\xbe\xd0\xbc\xd1\x81\xd1\x83 \xd0\xbd\xd0\xb0\xd1\x88\xd0\xbb\xd0\xbe\xd1\x81\xd1\x8c \xd0\xb1\xd0\xbe\xd0\xbb\xd1\x8c\xd1\x88\xd0\xb5\xd0\xb5\\n                dict[nums2[last]] = nums2[i]\\n            stack.append(i)\\n\\n        for l in range(len(ans)):\\n            ans[l] = dict.get(nums1[l], -1)       \\n\\n        return ans","compare_