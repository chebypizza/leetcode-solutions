\\n        while i < l1 or j < l2:\\n            if i < l1:\\n                ans += word1[i]\\n                i += 1\\n            if j < l2:\\n                ans += word2[j]\\n                j += 1\\n            \\n        return ans","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"merge-strings-alternately","has_notes":false,"flag_type":1,"frontend_id":411},{"id":2109520914,"question_id":145,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786922354,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2109520914/","is_pending":"Not Pending","title":"Binary Tree Postorder Traversal","memory":"19.4 MB","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def postorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\\n        ans = []\\n\\n        def postOrder(node):\\n            if not node:\\n                return\\n\\n            postOrder(node.left)   #\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbe\xd0\xb1\xd1\x85\xd0\xbe\xd0\xb4 \xd0\xbb\xd0\xb5\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xb4\xd0\xb5\xd1\x80\xd0\xb5\xd0\xb2\xd0\xb0\\n            postOrder(node.right)    #\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd1\x8b\xd0\xb9 \xd0\xbe\xd0\xb1\xd1\x85\xd0\xbe\xd0\xb4 \xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe\\n            ans.append(node.val)\\n\\n        postOrder(root)\\n\\n        return ans","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-tree-postorder-traversal","has_notes":false,"flag_type":1,"frontend_id":410},{"id":2108296018,"question_id":144,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786835151,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2108296018/","is_pending":"Not Pending","title":"Binary Tree Preorder Traversal","memory":"19.3 MB","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def preorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\\n        if root is None:\\n            return []\\n\\n        stack = [root]\\n        ans = []\\n\\n        while stack:\\n            node = stack.pop()\\n            ans.append(node.val)\\n            \\n            #\xd1\x81\xd0\xbd\xd0\xb0\xd1\x87\xd0\xb0\xd0\xbb\xd0\xb0 \xd0\xb2 \xd1\x81\xd1\x82\xd0\xb5\xd0\xba \xd0\xba\xd0\xb8\xd0\xb4\xd0\xb0\xd0\xb5\xd0\xbc \xd0\xbf\xd1\x80\xd0\xb0\xd0\xb2\xd0\xbe\xd0\xb3\xd0\xbe, \xd1\x87\xd1\x82\xd0\xbe\xd0\xb1\xd1\x8b \xd0\xbb\xd0\xb5\xd0\xb2\xd1\x8b\xd0\xb9 \xd0\xbe\xd0\xba\xd0\xb0\xd0\xb7\xd0\xb0\xd0\xbb\xd1\x81\xd1\x8f \xd0\xbd\xd0\xb0 \xd0\xb2\xd0\xb5\xd1\x80\xd1\x88\xd0\xb8\xd0\xbd\xd0\xb5 \xd1\x81\xd1\x82\xd0\xb5\xd0\xba\xd0\xb0\\n            if node.right:\\n                stack.append(node.right)\\n            if node.left:\\n                stack.append(node.left)\\n\\n        return ans","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-tree-preorder-traversal","has_notes":false,"flag_type":1,"frontend_id":409},{"id":2108295679,"question_id":144,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786835078,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2108295679/","is_pending":"Not Pending","title":"Binary Tree Preorder Traversal","memory":"19.5 MB","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def preorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\\n        if root is None:\\n            return []\\n\\n        stack = [root]\\n        ans = []\\n\\n        while stack:\\n            node = stack.pop()\\n            ans.append(node.val)\\n            \\n            if node.right:\\n                stack.append(node.right)\\n            if node.left:\\n                stack.append(node.left)\\n\\n        return ans","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-tree-preorder-traversal","has_notes":false,"flag_type":1,"frontend_id":408},{"id":2108294060,"question_id":144,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786834745,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2108294060/","is_pending":"Not Pending","title":"Binary Tree Preorder Traversal","memory":"19.4 MB","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def preorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\\n        if root is None:\\n            return []\\n\\n        stack = []\\n        ans = []\\n\\n        while root or stack:\\n            while root:\\n                ans.append(root.val)\\n                stack.append(root)\\n                root = root.left\\n            root = stack.pop()\\n            root = root.right\\n\\n        return ans","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-tree-preorder-traversal","has_notes":false,"flag_type":1,"frontend_id":407},{"id":2108291817,"question_id":94,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786834267,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2108291817/","is_pending":"Not Pending","title":"Binary Tree Inorder Traversal","memory":"19.2 MB","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def inorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\\n        if root is None:\\n            return []\\n        \\n        ans = []\\n        stack = []\\n\\n        while root or stack:\\n            while root:\\n                stack.append(root)\\n                root = root.left\\n            root = stack.pop()\\n            ans.append(root.val)\\n            root = root.right\\n\\n        return ans","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-tree-inorder-traversal","has_notes":false,"flag_type":1,"frontend_id":406},{"id":2107074464,"question_id":42,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786744032,"status":10,"status_display":"Accepted","runtime":"7 ms","url":"/submissions/detail/2107074464/","is_pending":"Not Pending","title":"Trapping Rain Water","memory":"21 MB","code":"class Solution:\\n    def trap(self, height: List[int]) -> int:\\n        if not height:\\n            return 0\\n\\n        left = 0\\n        right = len(height) - 1\\n        generalSize = 0\\n\\n        maxLeft = height[left]\\n        maxRight = height[right]\\n\\n        while left < right:\\n            if maxLeft <= maxRight:\\n                left += 1\\n                if height[left] < maxLeft:\\n                    generalSize += maxLeft - height[left]\\n                else:\\n                    maxLeft = height[left]\\n            else:\\n                right -= 1\\n                if height[right] < maxRight:\\n                    generalSize += maxRight - height[right]\\n                else:\\n                    maxRight = height[right]\\n\\n        return generalSize","compare_result":"","title_slug":"trapping-rain-water","has_notes":false,"flag_type":1,"frontend_id":405},{"id":2107074016,"question_id":42,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786743953,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2107074016/","is_pending":"Not Pending","title":"Trapping Rain Water","memory":"N/A","code":"class Solution:\\n    def trap(self, height: List[int]) -> int:\\n\\n        left = 0\\n        right = len(height) - 1\\n        generalSize = 0\\n\\n        maxLeft = height[left]\\n        maxRight = height[right]\\n\\n        while left < right:\\n            if maxLeft <= maxRight:\\n                if height[left] < maxLeft:\\n                    generalSize += maxLeft - height[left]\\n                else:\\n                    maxLeft = height[left]\\n                left += 1\\n            else:\\n                if height[right] < maxRight:\\n                    generalSize += maxRight - height[right]\\n                else:\\n                    maxRight = height[right]\\n                right -= 1\\n\\n        return generalSize","compare_result":"","title_slug":"trapping-rain-water","has_notes":false,"flag_type":1,"frontend_id":404},{"id":2107068356,"question_id":42,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786742978,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2107068356/","is_pending":"Not Pending","title":"Trapping Rain Water","memory":"N/A","code":"class Solution:\\n    def trap(self, height: List[int]) -> int:\\n        # 2 - 0, 2 - 1\\n\\n        left = 0\\n        right = len(height) - 1\\n        generalSize = 0\\n\\n        while left < len(height) and height[left] == 0:\\n            left += 1\\n        while right > 0 and height[right] == 0:\\n            right -= 1\\n\\n        while left < right:\\n            if left + 1 < right and height[left] > height[left + 1]:\\n                righterLeft = left\\n                curLeft = height[left]\\n                size = 0\\n\\n                while righterLeft < right and curLeft > height[righterLeft + 1]:\\n                    size += height[righterLeft + 1]\\n                    righterLeft += 1\\n\\n                if righterLeft + 1 <= right and height[righterLeft + 1] >= curLeft:\\n                    generalSize += (righterLeft - left) * curLeft - size\\n                    left = righterLeft + 1\\n                    continue\\n\\n            if left < right - 1 and height[right] > height[right - 1]:\\n                lefterRight = right\\n                curRight = height[right]\\n                size = 0\\n\\n                while lefterRight > left and curRight > height[lefterRight - 1]:\\n                    size += height[lefterRight - 1]\\n                    lefterRight -= 1\\n\\n                if lefterRight - 1 >= left and height[lefterRight - 1] >= curRight:\\n                    generalSize += (right - lefterRight) * curRight - size\\n                    right = lefterRight - 1\\n                    continue\\n\\n            if height[left] <= height[right]:\\n                left += 1\\n            else:\\n                right -= 1\\n\\n        return generalSize","compare_result":"","title_slug":"trapping-rain-water","has_notes":false,"flag_type":1,"frontend_id":403},{"id":2107065017,"question_id":42,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786742443,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/2107065017/","is_pending":"Not Pending","title":"Trapping Rain Water","memory":"N/A","code":"class Solution:\\n    def trap(self, height: List[int]) -> int:\\n        # 2 - 0, 2 - 1\\n\\n        left = 0\\n        right = len(height) - 1\\n        generalSize = 0\\n\\n        while left < len(height) and height[left] == 0:\\n            left += 1\\n        while right > 0 and height[right] == 0:\\n            right -= 1\\n\\n        while left < right:\\n            if left + 1 < right and height[left] > height[left + 1]:\\n                righterLeft = left\\n                curLeft = height[left]\\n                size = 0\\n\\n                while righterLeft < right and curLeft > height[righterLeft + 1]:\\n                    size += max(0, curLeft - height[righterLeft + 1])\\n                    righterLeft += 1\\n\\n                if righterLeft < right and height[righterLeft + 1] >= curLeft:\\n                    generalSize += size\\n                    left = righterLeft + 1\\n                    continue\\n\\n            if left < right - 1 and height[right] > height[right - 1]:\\n                lefterRight = right\\n                curRight = height[right]\\n                size = 0\\n\\n                while lefterRight > left and curRight > height[lefterRight - 1]:\\n                    size += max(0, curRight - height[lefterRight - 1])\\n                    lefterRight -= 1\\n\\n                if lefterRight > left and height[lefterRight - 1] >= curRight:\\n                    generalSize += size\\n                    right = lefterRight - 1\\n                    continue\\n\\n            if height[left] <= height[right]:\\n                left += 1\\n            else:\\n                right -= 1\\n\\n        return generalSize","compare_result":"","title_slug":"trapping-rain-water","has_notes":false,"flag_type":1,"frontend_id":402},{"id":2107057724,"question_id":42,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1786741389,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2107057724