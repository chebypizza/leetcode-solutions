e":"0 ms","url":"/submissions/detail/2138887137/","is_pending":"Not Pending","title":"Find K Closest Elements","memory":"36.3 MB","code":"class Solution {\\npublic:\\n    vector<int> findClosestElements(vector<int>& arr, int k, int x) {\\n        std::vector<int> ans;\\n        int low = 0;\\n        int high = arr.size();\\n\\n        while (low < high){\\n            int mid = (low + high) / 2;\\n\\n            if (arr[mid] < x){\\n                low = mid + 1;\\n            }\\n            else{\\n                high = mid;\\n            }\\n        }\\n\\n        int left = low - 1;\\n\\n        while (ans.size() != k){\\n            if (left < 0){\\n                ans.push_back(arr[low]);\\n                low++;\\n            }\\n            else if (low == arr.size()){\\n                ans.push_back(arr[left]);\\n                left--;\\n            }\\n            else if (std::abs(arr[left] - x) <= std::abs(arr[low] - x)){\\n                ans.push_back(arr[left]);\\n                left--;\\n            }\\n            else{\\n                ans.push_back(arr[low]);\\n                low++;\\n            }\\n        }\\n\\n        std::sort(ans.begin(), ans.end());\\n\\n        return ans;\\n    }\\n};","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"find-k-closest-elements","has_notes":false,"flag_type":1,"frontend_id":504},{"id":2138885237,"question_id":658,"lang":"cpp","lang_name":"C++","time":"1\xc2\xa0month, 4\xc2\xa0weeks","timestamp":1789151951,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/2138885237/","is_pending":"Not Pending","title":"Find K Closest Elements","memory":"N/A","code":"class Solution {\\npublic:\\n    vector<int> findClosestElements(vector<int>& arr, int k, int x) {\\n        std::vector<int> ans;\\n        int low = 0;\\n        int high = arr.size();\\n\\n        while (low < high){\\n            int mid = (low + high) / 2;\\n\\n