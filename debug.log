35/","is_pending":"Not Pending","title":"Evaluate Reverse Polish Notation","memory":"20.5 MB","code":"class Solution:\\n    def evalRPN(self, tokens: List[str]) -> int:\\n        stack = []\\n\\n        for operation in tokens:\\n            if operation == \'+\':\\n                stack[-2] += stack[-1]\\n                stack.pop()\\n            elif operation == \'-\':\\n                stack[-2] -= stack[-1]\\n                stack.pop()\\n            elif operation == \'*\':\\n                stack[-2] *= stack[-1]\\n                stack.pop()\\n            elif operation == \'/\':\\n                stack[-2] = int(stack[-2] / stack[-1])\\n                stack.pop()\\n            else:\\n                stack.append(int(operation))\\n\\n        return stack[0]","compare_result":"1111111111111111111111","title_slug":"evaluate-reverse-polish-notation","has_notes":false,"flag_type":1,"frontend_id":431},{"id":2114493305,"question_id":682,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1787267736,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2114493305/","is_pending":"Not Pending","title":"Baseball Game","memory":"19.4 MB","code":"class Solution:\\n    def calPoints(self, operations: List[str]) -> int:\\n        if not operations:\\n            return 0\\n\\n        stack = []\\n\\n        for cur in operations:\\n            if cur == \'+\':\\n                stack.append(stack[-1] + stack[-2])\\n            elif cur == \'C\':\\n                stack.pop()\\n            elif cur == \'D\':\\n                stack.append(stack[-1] * 2)\\n            else:\\n                stack.append(int(cur))\\n\\n        return sum(stack)","compare_result":"111111111111111111111111111111111111111","title_slug":"baseball-game","has_notes":false,"flag_type":1,"frontend_id":430},{"id":2114492541,"question_id":682,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 2\xc2\xa0weeks","timestamp":1787267561,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/2114492541/","is_pending":"Not Pending","title":"Baseball Game","memory":"19.5 MB","code":"class Solution:\\n    def calPoints(self, operations: List[str]) -> int:\\n        if not operations:\\n            return 0\\n            \\n        stack = []\\n\\n        for i in range(len(operations)):\\n            cur = operations[i]\\n            if cur == \'+\':\\n                stack.append(int(stack[-1]) + int(stack[-2]))\\n            elif cur == \'C\':\\n                stack.pop(-1)\\n            elif cur == \'D\':\\n                stack.append(int(stack[-1]) * 2)\\n            else:\\n                stack.append(int(cur))\\n\\n        return sum(stack)","compare_result":"111111111111111111111111111111111111111","title_slug":"baseball-game","has_notes":false,"flag_type":1,"frontend_id":429},{"id":2113299431,"question_id":917,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1787184002,"status":10,"status_display":"Accepted","runtime":"54 ms","url":"/submissions/detail/2113299431/","is_pending":"Not Pending","title":"Boats to Save People","memory":"25.3 MB","code":"class Solution:\\n    def numRescueBoats(self, people: List[int], limit: int) -> int:\\n        # [1,2,2,3], limit = 3\\n        people.sort()\\n\\n        left = 0\\n        right = len(people) - 1\\n        ans = 0\\n\\n        while left <= right:\\n            if people[left] + people[right] <= limit:\\n                left += 1\\n                right -= 1\\n            else:\\n                right -= 1\\n\\n            ans += 1   \\n\\n        return ans","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"boats-to-save-people","has_notes":false,"flag_type":1,"frontend_id":428},{"id":2113292522,"question_id":917,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","time