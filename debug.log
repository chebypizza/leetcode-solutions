      for j in range(length2 - 1, -1, -1):\\n                if text1[i] == text2[j]:\\n                    curRow[j] = nextRow[j + 1] + 1\\n                else:\\n                    curRow[j] = max(nextRow[j], curRow[j + 1])\\n\\n            nextRow = curRow\\n\\n        return nextRow[0]","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"longest-common-subsequence","has_notes":false,"flag_type":1,"frontend_id":567},{"id":2162510980,"question_id":1250,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month","timestamp":1791145406,"status":10,"status_display":"Accepted","runtime":"292 ms","url":"/submissions/detail/2162510980/","is_pending":"Not Pending","title":"Longest Common Subsequence","memory":"44.3 MB","code":"class Solution:\\n    def longestCommonSubsequence(self, text1: str, text2: str) -> int:\\n        length1 = len(text1)\\n        length2 = len(text2)\\n\\n        dp = [[0] * (length2 + 1) for _ in range(length1 + 1)]\\n\\n        for i in range(length1 - 1, -1, -1):\\n            for j in range(length2 - 1, -1, -1):\\n                if text1[i] == text2[j]:\\n                    dp[i][j] = dp[i + 1][j + 1] + 1\\n                else:\\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j + 1])\\n\\n        return dp[0][0]","compare_result":"1111111111111111111111111111111111111111111111111","title_slug":"longest-common-subsequence","has_notes":false,"flag_type":1,"frontend_id":566},{"id":2161509765,"question_id":516,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month","timestamp":1791066813,"status":10,"status_display":"Accepted","runtime":"602 ms","url":"/submissions/detail/2161509765/","is_pending":"Not Pending","title":"Longest Palindromic Subsequence","memory":"35.7 MB","code":"class Solution:\\n    def longestPalindromeSubseq(self, s: str) -> int:\\n        n = len(s)\\n\\n        dp = [[0] * n for _ in range(n)]\\n\\n        for i in range(n - 1, -1, -1):\\n            for j in range(i, n):\\n                if i == j:\\n                    dp[i][i] = 1\\n                elif s[i] == s[j]:\\n                    dp[i][j] = dp[i + 1][j - 1] + 2\\n                else:\\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\\n\\n        return dp[0][n - 1]","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-subsequence","has_notes":false,"flag_type":1,"frontend_id":565},{"id":2161506039,"question_id":647,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month","timestamp":1791066052,"status":10,"status_display":"Accepted","runtime":"247 ms","url":"/submissions/detail/2161506039/","is_pending":"Not Pending","title":"Palindromic Substrings","memory":"27.2 MB","code":"class Solution:\\n    def countSubstrings(self, s: str) -> int:\\n        n = len(s)\\n        counter = 0\\n\\n        dp = [[False] * n for _ in range(n)]\\n\\n        for i in range(n - 1, -1, -1):\\n            for j in range(i, n):\\n                if i == j:\\n                    dp[i][i] = True\\n                else:\\n                    dp[i][j] = s[i] == s[j] and (j - i < 3 or dp[i + 1][j - 1])\\n\\n                if dp[i][j]:\\n                    counter += 1\\n\\n        return counter","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"palindromic-substrings","has_notes":false,"flag_type":1,"frontend_id":564},{"id":2161505005,"question_id":647,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month","timestamp":1791065860,"status":10,"status_display":"Accepted","runtime":"235 ms","url":"/submissions/detail/2161505005/","is_pending":"Not Pending","title":"Palindromic Substrings","memory":"27.4 MB","code":"class Solution:\\n    def countSubstrings(self, s: str) -> int:\\n        n = len(s)\\n        counter = 0\\n\\n        dp = [[False] * n for _ in range(n)]\\n\\n        for i in range(n - 1, -1, -1):\\n            for j in range(i, n):\\n                if i == j:\\n                    dp[i][i] = True\\n\\n                dp[i][j] = s[i] == s[j] and (j - i < 3 or dp[i + 1][j - 1])\\n\\n                if dp[i][j]:\\n                    counter += 1\\n\\n        return counter","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"palindromic-substrings","has_notes":false,"flag_type":1,"frontend_id":563},{"id":2160573359,"question_id":338,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1790977191,"status":10,"status_display":"Accepted","runtime":"4 ms","url":"/submissions/detail/2160573359/","is_pending":"Not Pending","title":"Counting Bits","memory":"20.2 MB","code":"class Solution:\\n    def countBits(self, n: int) -> List[int]:\\n        dp = [0] * (n + 1)\\n        num = 1\\n\\n        for i in range(1, n + 1):\\n            if num * 2 == i:\\n                num = i\\n\\n            dp[i] = dp[i - num] + 1\\n\\n        return dp","compare_result":"111111111111111","title_slug":"counting-bits","has_notes":false,"flag_type":1,"frontend_id":562},{"id":2159542193,"question_id":5,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1790880415,"status":10,"status_display":"Accepted","runtime":"2679 ms","url":"/submissions/detail/2159542193/","is_pending":"Not Pending","title":"Longest Palindromic Substring","memory":"27.3 MB","code":"class Solution:\\n    def longestPalindrome(self, s: str) -> str:\\n        size = len(s)\\n        if size <= 1:\\n            return s\\n            \\n        longest = \'\'\\n        dp = [[False] * size for _ in range(size)] \\n\\n        for i in range(size - 1, -1, -1):\\n            for j in range(i, size):\\n                if i == j:\\n                    dp[i][i] = True\\n                elif j - i == 1:\\n                    dp[i][j] = s[i] == s[j]\\n                else:\\n                    dp[i][j] = s[i] == s[j] and dp[i + 1][j - 1]\\n\\n                if dp[i][j]:\\n                    palindrome = s[i:j + 1]\\n                    if len(palindrome) > len(longest):\\n                        longest = palindrome\\n\\n        return longest","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-substring","has_notes":false,"flag_type":1,"frontend_id":561},{"id":2159541143,"question_id":5,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1790880335,"status":10,"status_display":"Accepted","runtime":"2695 ms","url":"/submissions/detail/2159541143/","is_pending":"Not Pending","title":"Longest Palindromic Substring","memory":"27.1 MB","code":"class Solution:\\n    def longestPalindrome(self, s: str) -> str:\\n        longest = \'\'\\n        size = len(s)\\n        dp = [[False] * size for _ in range(size)] \\n\\n        for i in range(size - 1, -1, -1):\\n            for j in range(i, size):\\n                if i == j:\\n                    dp[i][i] = True\\n                elif j - i == 1:\\n                    dp[i][j] = s[i] == s[j]\\n                else:\\n                    dp[i][j] = s[i] == s[j] and dp[i + 1][j - 1]\\n\\n                if dp[i][j]:\\n                    palindrome = s[i:j + 1]\\n                    if len(palindrome) > len(longest):\\n                        longest = palindrome\\n\\n        return longest","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"longest-palindromic-substring","has_notes":false,"flag_type":1,"frontend_id":560}],"has_next":true,"last_key":""}'
